# ==============================================================================
# Apigee CI/CD Demo - Example Environment Configuration (.env.example)
# ==============================================================================

# Google Cloud Platform & Apigee Organization
GCP_PROJECT=your-gcp-project-id
APIGEE_ORG=your-apigee-org-id
APIGEE_ENV=eval
APIGEE_HOSTNAME=your-apigee-host.nip.io

# Apigee Proxy & KVM Configuration
PROXY_NAME=apigee-cicd-v1
KVM_NAME=apigee_secrets
KVM_KEY=secret_demo

# Secret Manager Configuration
SECRET_NAME=secret_demo

# Workload Identity Federation (WIF) Configuration
WIF_PROVIDER=projects/1234567890/locations/global/workloadIdentityPools/github-pool/providers/github-provider
WIF_SERVICE_ACCOUNT=apigee-deployer-sa@your-gcp-project-id.iam.gserviceaccount.com

# Deployment & Runner Settings
DEPLOYMENT_MAX_ATTEMPTS=30
DEPLOYMENT_DELAY_SECONDS=5
NODE_VERSION=20
