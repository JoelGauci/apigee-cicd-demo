# ==============================================================================
# Apigee CI/CD Demo - Environment Configuration (.env)
# ==============================================================================

# Google Cloud Platform & Apigee Organization
GCP_PROJECT=apigee-x-jog
APIGEE_ORG=apigee-x-jog
APIGEE_ENV=prod
APIGEE_HOSTNAME=34.54.8.132.nip.io

# Apigee Proxy & KVM Configuration
PROXY_NAME=apigee-cicd-v1
KVM_NAME=apigee_secrets
KVM_KEY=secret_demo

# Secret Manager Configuration
SECRET_NAME=secret_demo

# Workload Identity Federation (WIF) Configuration
WIF_PROVIDER=projects/1014194238001/locations/global/workloadIdentityPools/github-pool/providers/github-provider
WIF_SERVICE_ACCOUNT=apigee-deployer-sa@apigee-x-jog.iam.gserviceaccount.com

# Deployment & Runner Settings
DEPLOYMENT_MAX_ATTEMPTS=30
DEPLOYMENT_DELAY_SECONDS=5
NODE_VERSION=20
